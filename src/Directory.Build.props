<Project>
  <!-- Shared by the switcher (AltTabEverywhere) and the settings window (AltTabEverywhere.Settings). -->
  <PropertyGroup>
    <Version>0.7.1</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 the AltTab Everywhere contributors</Copyright>
    <!-- Usings are explicit: the code base mixes Win32 and WPF names (Window, Point...). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Always-on app: no background GC thread, and keep the heap small. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
</Project>
